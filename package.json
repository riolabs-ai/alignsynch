{
  "name": "quizhub",
  "version": "1.20.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && node scripts/build-cache.mjs tsc",
    "check:fast": "node scripts/check-fast.mjs",
    "data:check": "tsc -p tsconfig.datacheck.json && node --test .datacheck/scripts/__tests__/*.test.js && node .datacheck/scripts/data-check.js && node scripts/sample-brand-colors.mjs --check && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/ts-modules.mjs scripts/gen-brand-icons.mjs --check",
    "test": "vitest run",
    "parity": "node scripts/parity.mjs",
    "parity:update": "node scripts/parity.mjs --update",
    "bundles": "tsc -p tsconfig.datacheck.json && node .datacheck/scripts/bundles.js",
    "bundle:pack": "tsc -p tsconfig.datacheck.json && node .datacheck/scripts/bundle-platform.js pack",
    "bundle:unpack": "tsc -p tsconfig.datacheck.json && node .datacheck/scripts/bundle-platform.js unpack",
    "bundle:identities": "tsc -p tsconfig.datacheck.json && node .datacheck/scripts/bundle-platform.js identities",
    "gen": "node scripts/gen-fixtures.mjs",
    "growth": "node --import ./scripts/ts-modules.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/growth.ts",
    "growth:check": "node --import ./scripts/ts-modules.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/growth-check.ts",
    "nav:menu": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/nav-menu.ts",
    "qa:links": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/qa-links.ts",
    "qa:atlas": "node --import ./scripts/ts-modules.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/qa-atlas.mjs",
    "qa:atlas:check": "node --import ./scripts/ts-modules.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/qa-atlas-check.mjs",
    "qa:atlas:prune": "node --import ./scripts/ts-modules.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/qa-atlas.mjs --prune",
    "brand:icons": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/ts-modules.mjs scripts/gen-brand-icons.mjs",
    "glossary": "node scripts/gen-glossary.mjs",
    "glossary:check": "node scripts/gen-glossary.mjs --check",
    "email:bodies": "node --import ./scripts/ts-modules.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/gen-email-bodies.mjs",
    "email:bodies:check": "node --import ./scripts/ts-modules.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/gen-email-bodies.mjs --check",
    "ui:registry": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/gen-ui-registry.mjs",
    "ui:registry:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/gen-ui-registry.mjs --check",
    "ui:census": "tsc -p tsconfig.datacheck.json && node .datacheck/scripts/ui-census.js",
    "vocabulary:census": "tsc -p tsconfig.datacheck.json && node .datacheck/scripts/vocabulary.js",
    "columns:check": "node scripts/column-refs.ts --check",
    "release": "bash scripts/release.sh",
    "release:check": "bash scripts/release.sh --check",
    "changelog": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/ts-modules.mjs scripts/changelog-view.mjs",
    "changelog:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/ts-modules.mjs scripts/changelog-view.mjs --check",
    "docs:nav": "node scripts/docs-nav.mjs --write",
    "docs:check": "node scripts/docs-check.mjs",
    "qa:retention": "node scripts/capture-retention.mjs",
    "qa:retention:report": "node scripts/capture-retention.mjs --report",
    "qa:retention:prune": "node scripts/capture-retention.mjs --prune",
    "md:check": "markdownlint-cli2 && node scripts/md-style.mjs --check",
    "md:fix": "markdownlint-cli2 --fix && node scripts/md-style.mjs && biome format --write docs",
    "release:note": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/ts-modules.mjs scripts/release-notify.mjs",
    "db:migrate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db-migrate.mjs",
    "db:seed": "node --import ./scripts/ts-modules.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db-seed.mjs",
    "db:seed:check": "node --import ./scripts/ts-modules.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db-seed.mjs --check",
    "db:seed:review": "node --import ./scripts/ts-modules.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db-seed.mjs --review",
    "db:seed:demo": "node --import ./scripts/ts-modules.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db-seed.mjs --demo-accounts",
    "db:verify": "node --import ./scripts/ts-modules.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db-verify.mjs",
    "admin:ensure": "node --import ./scripts/ts-modules.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db-admin-ensure.mjs",
    "health:record": "node --import ./scripts/ts-modules.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/health-record.mjs",
    "demo:verify": "node --import ./scripts/ts-modules.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/demo-verify.mjs",
    "billing:smoke": "node --import ./scripts/ts-modules.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/billing-smoke.mjs",
    "billing:stripe:smoke": "node --import ./scripts/ts-modules.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/stripe-smoke.mjs",
    "billing:on-switch": "node --import ./scripts/ts-modules.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/billing-adapter-graph.mjs",
    "demo:reset": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/demo-reset.mjs",
    "flow:e2e": "node --import ./scripts/ts-modules.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/flow-e2e.mjs",
    "demo:flow": "node --import ./scripts/ts-modules.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/demo-flow.mjs",
    "demo:flow:check": "node --import ./scripts/ts-modules.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/demo-flow.mjs --check",
    "demo:flow:verify": "node --import ./scripts/ts-modules.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/demo-flow.mjs --verify",
    "payment:e2e": "node --import ./scripts/ts-modules.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/payment-e2e.mjs",
    "objstore:smoke": "node --import ./scripts/ts-modules.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/objstore-smoke.mjs",
    "env:sync": "node scripts/env-sync.mjs",
    "deploy:prune": "node scripts/vercel-prune.mjs",
    "deploy:demo": "node scripts/deploy-demo.mjs",
    "lint": "biome check && node scripts/lint-brand-classes.mjs",
    "lint:fix": "biome check --write && node scripts/lint-brand-classes.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "prototype:save": "node scripts/prototype-save.mjs"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "^1.3.1",
    "@hookform/resolvers": "^5.4.0",
    "@neon/auth": "^0.8.2",
    "@neon/config": "^1.9.5",
    "@neon/env": "^1.6.6",
    "@radix-ui/react-accordion": "^1.2.8",
    "@radix-ui/react-alert-dialog": "1.1.13",
    "@radix-ui/react-aspect-ratio": "1.1.6",
    "@radix-ui/react-avatar": "1.1.9",
    "@radix-ui/react-checkbox": "1.3.1",
    "@radix-ui/react-collapsible": "1.1.10",
    "@radix-ui/react-context-menu": "2.2.14",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.1.12",
    "@radix-ui/react-hover-card": "1.1.13",
    "@radix-ui/react-label": "^2.1.4",
    "@radix-ui/react-menubar": "1.1.14",
    "@radix-ui/react-navigation-menu": "1.2.12",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-progress": "^1.1.4",
    "@radix-ui/react-radio-group": "1.3.6",
    "@radix-ui/react-scroll-area": "^1.2.6",
    "@radix-ui/react-select": "^2.2.2",
    "@radix-ui/react-separator": "1.1.6",
    "@radix-ui/react-slider": "1.3.4",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.2.4",
    "@radix-ui/react-tabs": "^1.1.9",
    "@radix-ui/react-toast": "1.2.13",
    "@radix-ui/react-toggle": "1.1.8",
    "@radix-ui/react-toggle-group": "1.1.9",
    "@radix-ui/react-tooltip": "^1.2.4",
    "@stripe/stripe-js": "^10.2.1",
    "@types/canvas-confetti": "^1.9.0",
    "autoprefixer": "^10.4.21",
    "canvas-confetti": "^1.9.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "^4.1.0",
    "driver.js": "1.10.2",
    "embla-carousel-react": "8.6.0",
    "framer-motion": "^12.9.4",
    "input-otp": "1.4.2",
    "lucide-react": "^0.511.0",
    "next": "16.4.1",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.56.4",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^3.0.2",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^2.1.0",
    "sonner": "^2.0.3",
    "swiper": "^14.4.0",
    "tailwind-merge": "^3.3.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^30.1.3",
    "markdownlint-cli2": "^0.24.1",
    "postcss": "^8",
    "tailwindcss": "3.4.17",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
