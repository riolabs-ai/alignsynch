{
  "dataset": "demo-dataset.alignsynch.json",
  "brand": "alignsynch",
  "rows": {
    "record": 33,
    "item": 172,
    "response_option": 0,
    "relationship": 4,
    "session": 4,
    "party": 8,
    "opinion": 40,
    "billing_plan": 6,
    "demo_account": 3
  },
  "routes": [
    {
      "path": "/",
      "status": 200,
      "mustContain": ["Bring expectations into the open at work"],
      "mustNotContain": ["Internal Server Error", "Application error", "captcha"]
    },
    {
      "path": "/pricing",
      "status": 200,
      "mustContain": ["Simple, transparent pricing", "$8.95", "$16.95"],
      "mustNotContain": ["—/mo", "Internal Server Error", "Application error", "captcha"]
    },
    {
      "path": "/help",
      "status": 200,
      "mustContain": ["Answers to what the app does"],
      "mustNotContain": ["Internal Server Error", "Application error", "captcha"]
    },
    {
      "path": "/terms",
      "status": 200,
      "mustContain": ["The rules for using AlignSynch"],
      "mustNotContain": ["Internal Server Error", "Application error", "captcha"]
    },
    {
      "path": "/privacy",
      "status": 200,
      "mustContain": ["What AlignSynch collects"],
      "mustNotContain": ["Internal Server Error", "Application error", "captcha"]
    },
    {
      "path": "/assessments",
      "status": 307,
      "redirect": "/login"
    },
    {
      "path": "/dashboard",
      "status": 307,
      "redirect": "/login"
    },
    {
      "path": "/templates/relationship",
      "status": 307,
      "redirect": "/login"
    },
    {
      "path": "/assessment/templates",
      "status": 308,
      "redirect": "/templates/relationship"
    },
    {
      "path": "/assessments",
      "session": "initiator",
      "status": 200,
      "mustContain": ["My Relationships", "Start a relationship", "data-assessments-list"],
      "mustNotContain": ["data-assessments-unreadable", "data-assessments-empty"],
      "mustNameRelationship": true
    }
  ]
}
