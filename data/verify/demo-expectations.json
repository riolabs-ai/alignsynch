{
  "dataset": "demo-dataset.alignsynch.json",
  "brand": "alignsynch",
  "rows": {
    "record": 60,
    "item": 307,
    "response_option": 0,
    "relationship": 31,
    "session": 31,
    "session_invite": 31,
    "party": 56,
    "opinion": 205,
    "billing_plan": 6,
    "billing_subscription": 2,
    "demo_account": 3,
    "admin_action": 6,
    "billing_event": 2,
    "broadcast_recipient": 3,
    "broadcast_send": 1,
    "contact_message": 3,
    "contact_reply": 2,
    "email_event": 2,
    "news_signup": 5,
    "plan_grant": 1,
    "relationship_payment": 1,
    "review_issue": 2,
    "review_issue_comment": 2,
    "review_todo": 3
  },
  "routes": [
    {
      "path": "/",
      "status": 200,
      "mustContain": ["Bring expectations into the open at work"],
      "mustNotContain": ["Internal Server Error", "Application error", "captcha"]
    },
    {
      "path": "/pricing",
      "status": 200,
      "mustContain": ["Simple, transparent pricing", "$9.99", "$19.99"],
      "mustNotContain": ["—/mo", "Internal Server Error", "Application error", "captcha"]
    },
    {
      "path": "/help",
      "status": 200,
      "mustContain": ["Answers to what the app does"],
      "mustNotContain": ["Internal Server Error", "Application error", "captcha"]
    },
    {
      "path": "/terms",
      "status": 200,
      "mustContain": ["The rules for using AlignSynch"],
      "mustNotContain": ["Internal Server Error", "Application error", "captcha"]
    },
    {
      "path": "/privacy",
      "status": 200,
      "mustContain": ["What AlignSynch collects"],
      "mustNotContain": ["Internal Server Error", "Application error", "captcha"]
    },
    {
      "path": "/assessments",
      "status": 307,
      "redirect": "/login"
    },
    {
      "path": "/dashboard",
      "status": 307,
      "redirect": "/login"
    },
    {
      "path": "/templates/relationship",
      "status": 307,
      "redirect": "/login"
    },
    {
      "path": "/assessment/templates",
      "status": 308,
      "redirect": "/templates/relationship"
    },
    {
      "path": "/assessments",
      "session": "initiator",
      "status": 200,
      "mustContain": ["My Relationships", "Start a relationship", "data-assessments-list"],
      "mustNotContain": ["data-assessments-unreadable", "data-assessments-empty"],
      "mustNameRelationship": true
    }
  ]
}
