# The environment surface, by name. No values — copy to `.env.local` and fill it in.
#
# `.env.local` is gitignored (`.env*`), written by `neon env pull` for the database block, and is
# never committed. This file is the one place that lists what a deployment needs, so a new variable
# is documented by the change that adds it rather than by someone's memory of a Slack message.
#
# Every variable here is optional in the sense that matters: `bash scripts/verify.sh`, `pnpm build`
# and the keyless demo run with none of them set. What each one buys is noted beside it.

# --- Database (Neon Postgres) — server only, never inlined into the bundle ----------------------
# The pooled connection string the app reads at request time.
DATABASE_URL=
# The direct (unpooled) string: migrations and seeds are transactions over DDL, not pooler work.
DATABASE_URL_UNPOOLED=
# Which Neon branch the URL points at. Informational; the scripts print it.
NEON_BRANCH=
# The Neon project and the API key that can delete an account's managed-auth user (#278).
# `NEON_API_KEY` is a project-scoped key, so it CANNOT list projects: `GET /projects` answers 404
# and the project id must be named here. Server only — never inlined, never logged.
NEON_PROJECT_ID=
NEON_API_KEY=

# --- Auth (Neon Managed Better Auth) — server only ----------------------------------------------
# The auth service's base URL. Without it every page behind the shell answers signed-out.
NEON_AUTH_BASE_URL=
# The cookie signing secret. Also the key material the demo unlock cookie derives from.
NEON_AUTH_COOKIE_SECRET=
# Optional: the JWKS endpoint, when the auth service serves keys somewhere other than the default.
NEON_AUTH_JWKS_URL=
# Admin allowlist: comma-separated, case-insensitive. A sign-in whose verified (identity-provider)
# email is on this list is upserted as an admin. AlignSynch only — the quiz build never reads it.
# Empty or unset means no one is granted. Server only, never rendered.
ADMIN_EMAILS=

# --- Admin seats -------------------------------------------------------------------------------
# Seeded platform admins, read by `pnpm db:seed` (and by the demo reset's reseed). Each
# `ADMIN_NN_EMAIL` / `ADMIN_NN_PASS` pair is one durable `admin` account; with none set (CI, a
# fresh clone, the gate) the pass is skipped, never a failure. The password is read from the
# environment and written nowhere — never commit a value here, only the keys.
ADMIN_01_EMAIL=
ADMIN_01_PASS=
ADMIN_02_EMAIL=
ADMIN_02_PASS=

# --- Demo mode — off unless both are set --------------------------------------------------------
# `1` mounts /demo. Refused in production unless DEMO_ALLOW_PRODUCTION=1 as well.
DEMO_AUTH=
# The PIN the demo panel accepts. `DEMO_AUTH=1` with this unset is not demo mode.
DEMO_PIN=

# --- Email (Resend) — optional; the app reports "unset" honestly when absent --------------------
RESEND_API_KEY=
# The From address. Falls back to Resend's development sender when unset.
RESEND_FROM=
# Optional: another Resend-compatible endpoint, for a local stub.
RESEND_ENDPOINT=
# The webhook endpoint's signing secret (`whsec_…`), for `POST /api/resend/webhook` (#439b). Unset
# means the endpoint answers 503 to every delivery — it never accepts an unsigned one. Server-side
# only: never in `next.config.mjs`'s `env` block, never in a log line, never committed.
RESEND_WEBHOOK_SECRET=

# --- Brand skin ---------------------------------------------------------------------------------
# `quizhub` (default) or `alignsynch`. One tree, two builds: `BRAND=alignsynch pnpm build`.
BRAND=

# --- Billing ------------------------------------------------------------------------------------
# `mock` (default) or `stripe`. Unset means the keyless mock adapter: a deployment with no billing
# configuration still boots and still serves the pricing page.
BILLING_PROVIDER=
# `alignsynch` or `demo` — which deployment this is. Required whenever `BILLING_PROVIDER=stripe`,
# and deliberately with no default: a checkout stamps it as `metadata.host` on the session and on
# the subscription, and `/api/billing/webhook` applies only a delivery that claims its own value.
# Both hosts run test keys against one sandbox, so both receive every test event; a default would
# let one host claim the other's events.
BILLING_HOST=
# Test mode only. The key's own prefix must be the test-mode one, or the adapter refuses it: there
# is no live path and no fallback. Server only — never in next.config.mjs's `env` block, never in a
# log line.
STRIPE_TEST_SECRET_KEY=
# Test mode only. Carried for the deployment's own reference; hosted Checkout does not need it in
# the browser, so nothing reads it today.
STRIPE_TEST_PUBLISHABLE_KEY=
# Test mode only. The signing secret of the dashboard endpoint whose URL is `/api/billing/webhook`
# — NOT the secret `stripe listen` prints, which signs local forwards instead.
STRIPE_TEST_WEBHOOK_SECRET=

# --- Object storage (Neon) — optional; only `pnpm objstore:smoke` and media writes read it --------
NEON_OBJSTORE_ENDPOINT=
NEON_OBJSTORE_ACCESS_KEY=
NEON_OBJSTORE_SECRET_KEY=
NEON_OBJSTORE_BUCKET=
# `us-east-2` when unset.
NEON_OBJSTORE_REGION=
