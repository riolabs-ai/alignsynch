{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "//#web:build": {
      "cache": false,
      "env": ["BRAND", "DATABASE_URL", "NEXT_PUBLIC_BASE_URL"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "//#web:typecheck": {
      "cache": false,
      "env": ["BRAND", "NODE_ENV"]
    },
    "//#web:data:check": {
      "cache": false,
      "env": ["BRAND", "NODE_ENV", "DATABASE_URL"],
      "outputs": [".datacheck/**"]
    },
    "//#web:test": {
      "cache": false,
      "env": ["BRAND", "NODE_ENV", "DATABASE_URL", "CI"]
    },
    "//#web:lint": {
      "cache": false,
      "env": ["BRAND"]
    },
    "//#web:lint:fix": {
      "cache": false
    },
    "//#web:dev": {
      "cache": false,
      "persistent": true
    }
  }
}
