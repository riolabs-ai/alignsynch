{
  "$doc": {
    "schema": "demo-flow/v1",
    "purpose": "A browser walked the create flow on the demo instance and wrote down every screen. Committed so a reviewer, and the /how-it-works replay (#898 card 2), can read what happened without re-running it.",
    "topLevel": {
      "$doc": "this block — the schema, in the file it describes",
      "base": "the origin the walk ran against",
      "paths": "one entry per path: { path, terminal (the screen the path must end on, in words), reached, steps }",
      "findings": "behaviour the walk met that is not this driver's to fix: { n, path, title, shot, expected, actual, note }. A finding is a report, never a failure.",
      "steps": "every screen, in order — see fields",
      "seed": "what the run did about the demo dataset: { attempted, ok?, reason?, drift? }",
      "summary": "what this run found: { paths, reached, steps, findings }",
      "cleanup": "the branch before and after the walk: { created, before, after, leftover, unchanged }"
    },
    "fields": {
      "step": "1..n, contiguous across the three paths",
      "path": "create-published | create-draft | unpaid — a state, not a happy path",
      "route": "where the step happened; run-specific ids are normalised to <instance> and <token>",
      "action": "fill | click | assert",
      "values": "verbatim what was entered; {} for clicks and asserts",
      "shot": "docs/qa/demo-flow/<path>/<n>-<slug>-1440.png",
      "expect": "the assertion this step proved, in words",
      "ok": "whether it held; `actual` carries what was measured when it did not",
      "actual": "only present when ok is false",
      "sha256": "the digest of the image this run wrote — evidence of the run, not an invariant",
      "w": "the image's pixel width",
      "h": "the image's pixel height"
    },
    "determinism": "steps and paths carry no timestamp, id or absolute path, and two runs on an unchanged tree write them identically — that is what `pnpm demo:flow:check` diffs, byte for byte. `summary`, `seed`, `cleanup` and each step's `sha256` are measurements of one run or of a shared branch, so the diff excludes them: screenshots are compared by the geometry in `w`/`h`, because a page prints a minted invitation token, mounts the provider's live frame and seeds placeholder art from a row's id — none of which is byte-stable."
  },
  "base": "http://localhost:3411",
  "paths": [
    {
      "path": "create-published",
      "terminal": "the published relationship detail at /dashboard/relationships/<instance> (status draft, pairing not named)",
      "reached": false,
      "steps": 23
    },
    {
      "path": "create-draft",
      "terminal": "the draft reopened at /dashboard/relationships/<instance>",
      "reached": true,
      "steps": 11
    },
    {
      "path": "unpaid",
      "terminal": "the abandoned payment at /dashboard/relationships/<instance> — completion gate null, method missing, sealed null, relationship draft",
      "reached": false,
      "steps": 21
    }
  ],
  "findings": [
    {
      "n": 1,
      "path": "create-published",
      "title": "the app shell draws a Logout row to a signed-out visitor",
      "shot": "docs/qa/demo-flow/create-published/09-no-logout-for-stranger-1440.png",
      "expected": "no sign-out control before a session exists",
      "actual": "the sidebar's `Logout` row renders on the signed-out create stages",
      "note": "components/layout/sidebar.tsx renders the row unconditionally at the foot of the rail; pressing it on a signed-out page has nothing to end."
    },
    {
      "n": 2,
      "path": "create-published",
      "title": "the published path could not put a card on file, so Send never unlocks",
      "shot": null,
      "expected": "the pay walk reaches its thank-you step and data-send-gate=open",
      "actual": "the walk stopped before the send column opened",
      "note": null
    },
    {
      "n": 3,
      "path": "create-published",
      "title": "the relationship detail does not name either party, and is headed by the template's title",
      "shot": "docs/qa/demo-flow/create-published/23-detail-names-the-pairing-1440.png",
      "expected": "the detail naming Jordan Case and Sam Wren, under the title the creator gave the relationship",
      "actual": "h1 reads \"Relationship Basics\" (the template); the names exist only in the RSC payload — status draft",
      "note": "the listing row for the same record prints \"Demo walk — published\" and its counterparty's name, so the two surfaces disagree about what the record is called and who is in it."
    },
    {
      "n": 4,
      "path": "create-draft",
      "title": "create-draft: the relationship detail is headed by the template's name, not the draft's own title",
      "shot": "docs/qa/demo-flow/create-draft/34-draft-own-title-1440.png",
      "expected": "\"Demo walk — draft\" on the detail page",
      "actual": "WORKSPACE My Relationships My Assessments Templates SUPPORT How It Works Support Logout Version 1.16.0 Settings A Recent Messages No messages Conversations will appear here. Notifications No notifications You're all caught up! We'll notify you when something new happens. Relationship Basics Five Asp",
      "note": "the listing row prints the draft's own title, and the detail prints the template's (\"Relationship Basics\") — the row and the page disagree about what the record is called."
    },
    {
      "n": 5,
      "path": "unpaid",
      "title": "unpaid: the Sent screen draws no invitation link to claim",
      "shot": "docs/qa/demo-flow/unpaid/46-abandoned-payment-screen-1440.png",
      "expected": "the invitation URL as text on the screen (the `<code>` beside its copy control, #220)",
      "actual": "WORKSPACE My Relationships My Assessments Templates SUPPORT How It Works Support Logout Version 1.16.0 Settings A Recent Messages No messages Conversations will appear here. Notifications No notifications You're all caught up! We'll notify you when something new happens. Send the invitation Details Settings Aspects Account Invite STAGE 5 OF 5 Send the invitation The relationship is ready. Send the invitation now, or keep it as a draft and send it when you are ready. Advanced Mode is included in your seven-day trial. After the trial ends, it needs a plan that includes it. See plans and prices C",
      "note": null
    },
    {
      "n": 6,
      "path": "unpaid",
      "title": "unpaid: the payment step did not reach its terminal screen",
      "shot": "docs/qa/demo-flow/unpaid/55-abandoned-payment-1440.png",
      "expected": "the capture dialog, the provider's frame, and the abandoned-payment state behind it",
      "actual": "absent; frame absent; {\"method\":\"missing\",\"gate\":null,\"sealed\":null,\"openDialog\":0}",
      "note": null
    }
  ],
