{
  // markdownlint-cli2 — the markdown formatter (#937).
  //
  // ONE AUTHORITY PER CONCERN. Biome owns TypeScript, CSS and the paragraph wrapping
  // (`pnpm format:check`, lineWidth 100, biome.jsonc) — this file never re-wraps a paragraph,
  // which is why MD013 is off: the ban on reflow is the owner decision that keeps the two tools
  // from rewriting each other's output. What is left is the structural half Biome's markdown
  // formatter does not do: heading shape, fenced-code language tags, blank lines around blocks,
  // list markers and indentation, table row shape, trailing whitespace, code-span spaces.
  //
  // `node scripts/md-style.mjs --check` runs beside this in `pnpm md:check`; it owns the two
  // rewrites no linter can make (a fence's language tag, a line-leading `#` that GitHub renders as
  // a heading by accident).
  "globs": ["docs/**/*.md"],
  "ignores": [
    // GENERATED BYTES. These files are written whole by a script and compared byte for byte by
    // their own `--check` (`glossary:check`, `ui:registry:check`, `changelog:check`), so formatting
    // them here would be undone by the next generator run and fail that check in between. The
    // prettifying of those pages is the generator's job, not the formatter's — a second author
    // over the same bytes is the drift this repo keeps paying for.
    "docs/glossary.md",
    "docs/ui-registry.md",
    "docs/changelog/**",
    // BYTE-FROZEN DESIGN ARTIFACTS. The same three directories `biome.jsonc` excludes, for the same
    // reason it gives: they are an approved handoff committed byte-identical so the build can be
    // matched against them, and they are not ours to reformat.
    "docs/specs/spec-as2-style-home-redesign/**",
    "docs/specs/spec-as2-style-templates-redesign/**",
    "docs/specs/spec-design-page-rel-templates-v2/**"
  ],
  "config": {
    // NO LINE LENGTH. Paragraphs are never re-wrapped: Biome wraps at lineWidth 100 and markdownlint
    // has no opinion that could disagree without one of them flipping the other's output forever.
    "MD013": false,
    // INLINE HTML IS DELIBERATE. `<details>` is a real collapsible section, and the spec pages write
    // placeholders as `<name> (<date>)` — prose tokens markdownlint parses as unknown elements.
    // Escaping them would change the characters a reader copies out of the page.
    "MD033": false,
    // A BOLD LABEL IS NOT A HEADING. The records pages (`operations/history/*`, `reference/*`) state
    // a fact as a standalone `**Where it lives**` line above its paragraph. Promoting those to
    // headings would add 7 entries to every table of contents and change the page's outline.
    "MD036": false,
    // FRAGMENTS. The hub's contents links and the glossary's anchors are generated by
    // `scripts/docs-nav.mjs` / `gen-glossary.mjs`; a fragment that does not resolve is that
    // generator's defect and is reported in the PR that added this file, not silently corrected
    // here (a formatter that edits generated anchors is the second author again).
    "MD051": false,
    // CITATION MARKERS. `[10][11][7]` in `docs/guides/mimo-guide.md` is a footnote marker in the
    // source list at the foot of the page, not a reference-style link; GFM leaves an undefined
    // reference as literal text, which is exactly what the page means to show.
    "MD052": false,
    // SIBLINGS ONLY. `docs/ui-registry.md` repeats "Routes" and "Component domains" once per
    // component domain, and the two surviving cases (`guides/bundles.md`, the sequence diagram)
    // repeat a heading in a different section. A duplicate heading under a *different* parent is a
    // structure, not a mistake; a duplicate under the same parent still fails.
    "MD024": { "siblings_only": true },
    // BLANK LINES ARE BIOME'S. Measured, not assumed: Biome 2.6.3 joins a list to a preceding table
    // with no blank line between them, and MD032/MD058 demand one — so with both enabled the two
    // tools rewrite the same line in opposite directions on every run (4 files disagreed on the
    // first pass). `pnpm format:check` is already a gate step and cannot be changed, so Biome is the
    // tie-breaker and the two rules go off by name. Nothing is lost in practice: the fixer below
    // still requires blank lines around *fences* and headings (MD022/MD031), which Biome does not
    // touch, and the table→list adjacency Biome insists on is the shape `main` already carries.
    "MD032": false,
    "MD058": false,
    // TABLE PADDING IS BIOME'S, IN FULL. Both `aligned` and `compact` disagree with Biome here:
    // `aligned` cannot parse the one row whose cell holds an escaped pipe
    // (`grep "3DS\|3-D Secure"` in `specs/pay-to-complete/PAYER-PRESENT.md`) and reports a pipe that
    // will never align, and `compact` rejects the padded pipe on every row Biome formatted. The row
    // *shape* — every row has the header's cell count — is still enforced by MD055/MD056, so a
    // malformed table is still red; the widths are simply not a second opinion.
    "MD060": false
  }
}
