{
  // Single source of truth for linting and formatting (replaces `next lint`
  // and the old `.prettierrc` with printWidth 450).
  //
  // Formatting: lineWidth 100 is the agreed target, but this repo was
  // formatted at printWidth 450, so enabling the formatter as a gate today
  // would mean an ~18k-line diff mixed into a toolchain change. The one-shot
  // reformat lands in its own PR (see issue #5); `pnpm format` is available
  // now, and CI gates `pnpm lint` (lint rules only, no formatting check).
  //
  // Lint rules below that are set to "warn" already have violations on main.
  // They stay visible in CI output but do not fail the build; flip each one
  // back to "error" as its violations are fixed instead of suppressing them.
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noSvgWithoutTitle": "warn",
        "useButtonType": "warn",
        "noStaticElementInteractions": "warn",
        "useKeyWithClickEvents": "warn",
        "useSemanticElements": "warn",
        "noLabelWithoutControl": "warn",
        "useFocusableInteractive": "warn"
      },
      "correctness": {
        "useExhaustiveDependencies": "warn",
        "noSwitchDeclarations": "warn",
        "useJsxKeyInIterable": "warn",
        "useHookAtTopLevel": "warn",
        "noComponentHookFactories": "warn"
      },
      "suspicious": {
        "noArrayIndexKey": "warn",
        "noRedeclare": "warn"
      },
      "security": {
        "noDangerouslySetInnerHtml": "warn"
      }
    }
  },
  "overrides": [
    {
      // Tailwind's @tailwind / @apply / @layer at-rules are compiled away by
      // PostCSS before any browser sees them.
      "includes": ["**/*.css"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnknownAtRules": "off"
          }
        }
      }
    }
  ]
}
