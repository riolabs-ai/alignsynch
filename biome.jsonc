{
  // Single source of truth for linting and formatting (replaces `next lint`
  // and the old `.prettierrc` with printWidth 450).
  //
  // Formatting is enforced: the one-shot reformat at lineWidth 100 already
  // landed as a formatting-only commit (listed in .git-blame-ignore-revs) and
  // CI runs `pnpm format:check`, so `pnpm format` must produce no diff.
  //
  // Lint rules below that are set to "warn" already have violations on main.
  // They stay visible in CI output but do not fail the build; flip each one
  // back to "error" as its violations are fixed instead of suppressing them.
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    // pnpm-lock.yaml is generated: pnpm writes its own YAML quoting, so
    // letting the formatter touch it turns every `pnpm install` into a diff.
    //
    // `docs/review/artifacts/**` is a *review artifact* drop, not source (#665): the four files are
    // the lifecycle prototype exactly as it was drawn, published so the review shelf has something
    // versioned to point at. They are read in a sandboxed frame and never imported, so biome's HTML
    // a11y rules (`href="#"` on a prototype's own step controls) are findings about a design
    // document rather than about this tree — the same reason `lib/quizhub/**` is ignored, except
    // this directory is authored in-repo and the ignore is narrow to the artifacts, not to `docs/`.
    // `docs/specs/spec-as2-style-home-redesign` is the same kind of thing: an approved design
    // handoff kept as reference (a static HTML page, its own stylesheet) and never imported by the
    // app. Linting its `<div aria-label>` is a finding about the artifact, and the artifact is not
    // ours to edit — the build matches it, not the other way round.
    //
    // `docs/specs/spec-as2-style-templates-redesign` is the **second** approved design artifact kept
    // out of the build, for exactly the same reason and by the same narrow folder exclusion: the
    // public Templates catalogue's approved rewrite (#889), with its own page, specimen sheet,
    // stylesheets and images. It is a reference the React page is matched against, never a module
    // anything imports, so formatting it or linting its prototype markup would be a diff against a
    // document nobody should touch. Two entries, one rule — a per-file suppression is not the
    // answer here, and neither is widening the ignore to `docs/`.
    //
    // `docs/specs/spec-design-page-rel-templates-v2` is the third, and the rule holds unchanged:
    // the V2 package's home mockup, brand profile, their stylesheets and the prose that ships beside
    // them are a design handoff, committed byte-identical so the build can be matched against them
    // (#903). Biome's markdown formatter wants to re-wrap their sentences and its HTML a11y rules
    // want to fix the prototype's own `aria-label` — both are findings about a document this tree is
    // not allowed to edit.
    "includes": [
      "**",
      "!pnpm-lock.yaml",
      "!docs/review/artifacts",
      "!docs/specs/spec-as2-style-home-redesign",
      "!docs/specs/spec-as2-style-templates-redesign",
      "!docs/specs/spec-design-page-rel-templates-v2"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noSvgWithoutTitle": "warn",
        "useButtonType": "warn",
        "noStaticElementInteractions": "warn",
        "useKeyWithClickEvents": "warn",
        "useSemanticElements": "warn",
        "noLabelWithoutControl": "warn",
        "useFocusableInteractive": "warn"
      },
      "correctness": {
        "useExhaustiveDependencies": "warn",
        "noSwitchDeclarations": "warn",
        "useJsxKeyInIterable": "warn",
        "useHookAtTopLevel": "warn",
        "noComponentHookFactories": "warn"
      },
      "suspicious": {
        "noArrayIndexKey": "warn",
        "noRedeclare": "warn"
      },
      "security": {
        "noDangerouslySetInnerHtml": "warn"
      }
    }
  },
  "overrides": [
    {
      // Tailwind's @tailwind / @apply / @layer at-rules are compiled away by
      // PostCSS before any browser sees them.
      "includes": ["**/*.css"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnknownAtRules": "off"
          }
        }
      }
    }
  ]
}
