{
  // Single source of truth for linting and formatting (replaces `next lint`
  // and the old `.prettierrc` with printWidth 450).
  //
  // Formatting is enforced: the one-shot reformat at lineWidth 100 already
  // landed as a formatting-only commit (listed in .git-blame-ignore-revs) and
  // CI runs `pnpm format:check`, so `pnpm format` must produce no diff.
  //
  // Lint rules below that are set to "warn" already have violations on main.
  // They stay visible in CI output but do not fail the build; flip each one
  // back to "error" as its violations are fixed instead of suppressing them.
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    // pnpm-lock.yaml is generated: pnpm writes its own YAML quoting, so
    // letting the formatter touch it turns every `pnpm install` into a diff.
    //
    // tests/parity/snapshots is generated too, by a *render* (#171): the HTML a
    // component produces, not hand-written markup. Biome parses it as HTML and
    // reports the components' own a11y lints against their output — every
    // `<button>` shadcn renders without a `type` lands here a second time, in a
    // file that `pnpm parity:update` rewrites byte for byte. Those buttons are
    // already linted where they are written.
    "includes": ["**", "!pnpm-lock.yaml", "!tests/parity/snapshots"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noSvgWithoutTitle": "warn",
        "useButtonType": "warn",
        "noStaticElementInteractions": "warn",
        "useKeyWithClickEvents": "warn",
        "useSemanticElements": "warn",
        "noLabelWithoutControl": "warn",
        "useFocusableInteractive": "warn"
      },
      "correctness": {
        "useExhaustiveDependencies": "warn",
        "noSwitchDeclarations": "warn",
        "useJsxKeyInIterable": "warn",
        "useHookAtTopLevel": "warn",
        "noComponentHookFactories": "warn"
      },
      "suspicious": {
        "noArrayIndexKey": "warn",
        "noRedeclare": "warn"
      },
      "security": {
        "noDangerouslySetInnerHtml": "warn"
      }
    }
  },
  "overrides": [
    {
      // Tailwind's @tailwind / @apply / @layer at-rules are compiled away by
      // PostCSS before any browser sees them.
      "includes": ["**/*.css"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnknownAtRules": "off"
          }
        }
      }
    }
  ]
}
